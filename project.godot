; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Новый игровой проект"
run/main_scene="res://scenes/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

DisplayBootstrap="*res://autoload/display_bootstrap.gd"
DatabaseManager="*res://autoload/database_manager.gd"
WorldDatabase="*res://autoload/world_database.gd"
GameSession="*res://game/game_session.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-sqlite/plugin.cfg")

[gui]

theme/default_font_antialiasing=2
theme/custom="res://ui/theme/app_theme.tres"
theme/custom_font="res://assets/fonts/Inter-Regular.otf"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.06, 0.07, 0.09, 1)
