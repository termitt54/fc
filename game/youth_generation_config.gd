const TRAINING_GROWTH_SPAN := 0.60

## Expected rating of the legacy default country table (used to map → 500).
const LEGACY_DEFAULT_EXPECTED_PA := 62.605
const LEGACY_TALENT_SCALE := 20.0

const DEFAULT_BIRTH_CONFIG_PATH := "user://config/youth_talent_birth.json"
const BIRTH_WEIGHT_TOTAL := 100000000

static var config_path := DEFAULT_CONFIG_PATH
static var birth_config_path := DEFAULT_BIRTH_CONFIG_PATH
static var _loaded := false
static var _runtime_pa_buckets: Array = []
static var _birth_loaded := false
static var _runtime_birth: Array = []


static func clamp_youth_talent(value: int) -> int:
	return clampi(value, YOUTH_TALENT_MIN, YOUTH_TALENT_MAX)


static func youth_talent_grade(value: int) -> Dictionary:
	var talent := clamp_youth_talent(value)
	var fallback: Dictionary = YOUTH_TALENT_GRADES[YOUTH_TALENT_GRADES.size() - 1]
	for band in YOUTH_TALENT_GRADES:
		if talent >= int(band["min"]) and talent <= int(band["max"]):
			return band
	return fallback


static func youth_talent_grade_label(value: int) -> String:
	return str(youth_talent_grade(value).get("label", ""))


static func birth_weights(youth_talent: int) -> Array:
	_ensure_birth_loaded()
	return _runtime_birth[clamp_youth_talent(youth_talent)]


static func default_birth_weights() -> Array:
	return _copy_birth_rows(TALENT_BIRTH_WEIGHTS)


static func editor_birth_weights() -> Array:
	_ensure_birth_loaded()
	return _copy_birth_rows(_runtime_birth)


static func apply_birth_weights(rows: Array) -> Dictionary:
	var next := _validated_birth_rows(rows)
	if next.is_empty():
		return {"ok": false, "error": "У каждого таланта 0–100 сумма процентов должна быть 100%."}
	_runtime_birth = next
	_birth_loaded = true
	var err := _save_birth_to_disk()
	if err != OK:
		return {"ok": false, "error": "Не удалось сохранить таблицу талантов."}
	return {"ok": true, "error": ""}


static func reset_birth_to_defaults(persist: bool = false) -> Dictionary:
	_runtime_birth = default_birth_weights()
	_birth_loaded = true
	if not persist:
		return {"ok": true, "error": ""}
	var err := _save_birth_to_disk()
	if err != OK:
		return {"ok": false, "error": "Не удалось сохранить таблицу талантов."}
	return {"ok": true, "error": ""}


static func unload_birth() -> void:
	_birth_loaded = false
	_runtime_birth = []


static func _ensure_birth_loaded() -> void:
	if _birth_loaded:
		return
	_birth_loaded = true
	if not _load_birth_from_disk():
		_runtime_birth = default_birth_weights()


static func _validated_birth_rows(rows: Array) -> Array:
	if rows.size() != TALENT_BIRTH_WEIGHTS.size():
		return []
	var out: Array = []
	for row in rows:
		if typeof(row) != TYPE_ARRAY or (row as Array).size() != BIRTH_BANDS.size():
			return []
		var copy: Array = []
		var total := 0
		for weight in row:
			var tenths := int(weight)
			if tenths < 0:
				return []
			copy.append(tenths)
			total += tenths
		if total != BIRTH_WEIGHT_TOTAL:
			return []
		out.append(copy)
	return out


static func _copy_birth_rows(rows: Array) -> Array:
	var out: Array = []
	for row in rows:
		var copy: Array = []
		for weight in row:
			copy.append(int(weight))
		out.append(copy)
	return out


static func _load_birth_from_disk() -> bool:
	if not FileAccess.file_exists(birth_config_path):
		return false
	var file := FileAccess.open(birth_config_path, FileAccess.READ)
	if file == null:
		return false
	var parsed: Variant = JSON.parse_string(file.get_as_text())
	file.close()
	if typeof(parsed) != TYPE_DICTIONARY:
		return false
	var data: Dictionary = parsed
	var rows: Variant = data.get("rows", [])
	if typeof(rows) != TYPE_ARRAY:
		return false
	var version := int(data.get("version", 1))
	if version > BIRTH_CONFIG_VERSION:
		return false
	if version < 4:
		if (rows as Array).size() != 101:
			return false
		for row in rows:
			if typeof(row) != TYPE_ARRAY or row.size() != 6:
				return false
			var total := 0
			for weight in row:
				if int(weight) < 0:
					return false
				total += int(weight)
			if total != 1000:
				return false
		_runtime_birth = default_birth_weights()
		return true
	var next := _validated_birth_rows(rows)
	if next.is_empty():
		return false
	_runtime_birth = default_birth_weights() if _is_legacy_birth_default(next, version) else next
	return true


static func _save_birth_to_disk() -> Error:
	var dir_path := birth_config_path.get_base_dir()
	if not DirAccess.dir_exists_absolute(dir_path):
		var mkdir_err := DirAccess.make_dir_recursive_absolute(dir_path)
		if mkdir_err != OK:
			return mkdir_err
	var file := FileAccess.open(birth_config_path, FileAccess.WRITE)
	if file == null:
		return ERR_CANT_OPEN
	file.store_string(JSON.stringify({"version": BIRTH_CONFIG_VERSION, "rows": _runtime_birth}, "\t"))
	file.close()
	return OK


## The requested recalibration replaces old six-band settings in memory.
## Current v4 custom rows round-trip exactly; loading never rewrites the original file.
static func _is_legacy_birth_default(rows: Array, version: int) -> bool:
	return (version == 4 and rows == LEGACY_V4_BIRTH_WEIGHTS) or (version == 5 and rows == LEGACY_V5_BIRTH_WEIGHTS)


static func migrate_birth_rows(rows: Array, version: int) -> Array:
	if version < 4 or _is_legacy_birth_default(rows, version):
		return default_birth_weights()
	return _copy_birth_rows(rows)


## Regular professionals are sampled across the distribution per position/cohort.
## PA90+ keeps independent draws: stratification never guarantees a rare genius.
static func roll_birth_cohort(talent: int, count: int, rng: RandomNumberGenerator) -> Array:
	var native: Variant = NativeSimulation.core(false)
	if native != null:
		return native.roll_birth(birth_weights(talent),count,rng,true)
	var weights := birth_weights(talent)
	var total := 0
	var regular := 0
	for i in weights.size():
		total += int(weights[i])
		if i < 8:
			regular += int(weights[i])
	var result: Array = []
	for i in count:
		var roll := rng.randi_range(1, total)
		if roll > regular:
			var cumulative := regular
			for band in range(8, weights.size()):
				cumulative += int(weights[band])
				if roll <= cumulative:
					result.append(_roll_elite_rating(band, rng) if ELITE_RATING_WEIGHTS.has(band) else int(BIRTH_BANDS[band][0]))
					break
	var remaining := count - result.size()
	for i in remaining:
		var roll := mini(regular, int((float(i) + rng.randf()) * float(regular) / float(remaining)) + 1)
		var cumulative := 0
		for band in range(8):
			cumulative += int(weights[band])
			if roll <= cumulative:
				result.append(_roll_elite_rating(band, rng) if ELITE_RATING_WEIGHTS.has(band) else rng.randi_range(int(BIRTH_BANDS[band][0]), int(BIRTH_BANDS[band][1])))
				break
	for i in range(result.size() - 1, 0, -1):
		var j := rng.randi_range(0, i)
		var value: Variant = result[i]
		result[i] = result[j]
		result[j] = value
	return result


static func roll_birth_potential(youth_talent: int, rng: RandomNumberGenerator) -> int:
	var native: Variant = NativeSimulation.core(false)
	if native != null:
		return int(native.roll_birth(birth_weights(youth_talent),1,rng,false)[0])
	var weights: Array = birth_weights(youth_talent)
	var total := 0
	for weight in weights:
		total += int(weight)
	if total <= 0:
		return MIN_PA
	var roll := rng.randi_range(1, total)
	var acc := 0
	var index := weights.size() - 1
	for i in weights.size():
		acc += int(weights[i])
		if roll <= acc:
			index = i
			break
	var band: Array = BIRTH_BANDS[index]
	if ELITE_RATING_WEIGHTS.has(index):
		return _roll_elite_rating(index, rng)
	return rng.randi_range(int(band[0]), int(band[1]))


static func _roll_elite_rating(band: int, rng: RandomNumberGenerator) -> int:
	var weights: Array = ELITE_RATING_WEIGHTS[band]
	var roll := rng.randi_range(1, int(weights.reduce(func(a, b): return a + b, 0)))
	var cumulative := 0
	for i in weights.size():
		cumulative += int(weights[i])
		if roll <= cumulative:
			return int(BIRTH_BANDS[band][0]) + i
	return int(BIRTH_BANDS[band][0]) + weights.size() - 1


## Absolute probability of PA >= threshold, including within-band elite rarity.
static func potential_probability(youth_talent: int, threshold: int) -> float:
	return row_probability(birth_weights(youth_talent), threshold)


static func row_probability(weights: Array, threshold: int) -> float:
	var probability := 0.0
	for band in BIRTH_BANDS.size():
		var lo := int(BIRTH_BANDS[band][0])
		var hi := int(BIRTH_BANDS[band][1])
		if threshold > hi:
			continue
		var conditional := 1.0
		if threshold > lo:
			if ELITE_RATING_WEIGHTS.has(band):
				var tail := 0
				for i in range(threshold - lo, hi - lo + 1):
					tail += int(ELITE_RATING_WEIGHTS[band][i])
				conditional = float(tail) / float((ELITE_RATING_WEIGHTS[band] as Array).reduce(func(a, b): return a + b, 0))
			else:
				conditional = float(hi - threshold + 1) / float(hi - lo + 1)
		probability += float(weights[band]) / BIRTH_WEIGHT_TOTAL * conditional
	return probability


static func pa_tier_index(potential_ability: int) -> int:
	var buckets := get_pa_buckets()
	for i in buckets.size():
		var bucket: Dictionary = buckets[i]
		if potential_ability >= int(bucket["rating_min"]):
			return i
	return buckets.size() - 1


static func pa_bucket_key(bucket: Dictionary) -> String:
	var key := str(bucket.get("bucket_key", ""))
	if not key.is_empty():
		return key
	return "r%d_%d" % [int(bucket.get("rating_min", 0)), int(bucket.get("rating_max", 0))]


static func default_pa_buckets() -> Array:
	var out: Array = []
	for bucket in PA_BUCKETS:
		out.append((bucket as Dictionary).duplicate(true))
	return out


static func get_pa_buckets() -> Array:
	_ensure_loaded()
	return _runtime_pa_buckets


static func editor_pa_buckets() -> Array:
	return _to_editor_buckets(get_pa_buckets())


static func default_editor_pa_buckets() -> Array:
	return _to_editor_buckets(default_pa_buckets())


static func apply_pa_weights(weights: Dictionary) -> Dictionary:
	var next := _merge_weights(default_pa_buckets(), weights)
	var total := _weight_total(next)
	if absf(total - 100.0) >= WEIGHT_EPS:
		return {"ok": false, "error": "Сумма должна быть 100%% (сейчас %.2f%%)." % total}
	_runtime_pa_buckets = next
	_loaded = true
	var err := _save_to_disk()
	if err != OK:
		return {"ok": false, "error": "Не удалось сохранить файл настроек."}
	return {"ok": true, "error": ""}


static func reset_to_defaults(persist: bool = false) -> Dictionary:
	_runtime_pa_buckets = default_pa_buckets()
	_loaded = true
	if not persist:
		return {"ok": true, "error": ""}
	var err := _save_to_disk()
	if err != OK:
		return {"ok": false, "error": "Не удалось сохранить файл настроек."}
	return {"ok": true, "error": ""}


static func unload() -> void:
	_loaded = false
	_runtime_pa_buckets = []


static func _to_editor_buckets(buckets: Array) -> Array:
	var out: Array = []
	for bucket in buckets:
		var row: Dictionary = bucket.duplicate(true)
		var lo := int(row.get("rating_min", MIN_PA))
		var hi := int(row.get("rating_max", MAX_PA))
		row["bucket_key"] = pa_bucket_key(row)
		row["range_label"] = "%d–%d" % [lo, hi]
		out.append(row)
	return out


static func _ensure_loaded() -> void:
	if _loaded:
		return
	_loaded = true
	if not _load_from_disk():
		_runtime_pa_buckets = default_pa_buckets()


static func _load_from_disk() -> bool:
	if not FileAccess.file_exists(config_path):
		return false
	var file := FileAccess.open(config_path, FileAccess.READ)
	if file == null:
		return false
	var parsed: Variant = JSON.parse_string(file.get_as_text())
	file.close()
	if typeof(parsed) != TYPE_DICTIONARY:
		push_warning("YouthGenerationConfig: invalid JSON in %s, using defaults" % config_path)
		return false
	var data: Dictionary = parsed
	var weights: Variant = data.get("pa_weights", {})
	if typeof(weights) != TYPE_DICTIONARY:
		return false
	var next := _merge_weights(default_pa_buckets(), weights)
	var total := _weight_total(next)
	if absf(total - 100.0) >= WEIGHT_EPS:
		push_warning(
			"YouthGenerationConfig: PA weights in %s sum to %.2f, using defaults" % [config_path, total]
		)
		return false
	_runtime_pa_buckets = next
	return true


static func _save_to_disk() -> Error:
	var dir_path := config_path.get_base_dir()
	if not DirAccess.dir_exists_absolute(dir_path):
		var mkdir_err := DirAccess.make_dir_recursive_absolute(dir_path)
		if mkdir_err != OK:
			return mkdir_err
	var weights := {}
	for bucket in _runtime_pa_buckets:
		weights[pa_bucket_key(bucket)] = float(bucket.get("weight_pct", 0.0))
	var payload := {"version": CONFIG_VERSION, "pa_weights": weights}
	var file := FileAccess.open(config_path, FileAccess.WRITE)
	if file == null:
		return ERR_CANT_OPEN
	file.store_string(JSON.stringify(payload, "\t"))
	file.close()
	return OK


static func _merge_weights(buckets: Array, weights: Dictionary) -> Array:
	var out: Array = []
	for bucket in buckets:
		var row: Dictionary = (bucket as Dictionary).duplicate(true)
		var key := pa_bucket_key(row)
		if weights.has(key):
			row["weight_pct"] = snappedf(clampf(float(weights[key]), 0.0, 100.0), 0.01)
		out.append(row)
	return out


static func _weight_total(buckets: Array) -> float:
	var total := 0.0
	for bucket in buckets:
		total += float(bucket.get("weight_pct", 0.0))
	return snappedf(total, 0.01)


static func legacy_expected_to_talent(expected_pa: float) -> int:
	var raw := 500.0 + (expected_pa - LEGACY_DEFAULT_EXPECTED_PA) * LEGACY_TALENT_SCALE
	return clampi(int(round(raw)), 0, 1000)


static func talent_from_legacy_buckets(buckets: Array) -> int:
	var total_w := 0.0
	var expected := 0.0
	for bucket in buckets:
		var weight := float(bucket.get("weight_pct", 0.0))
		if weight <= 0.0:
			continue
		var lo := int(bucket.get("rating_min", MIN_PA))
		var hi := int(bucket.get("rating_max", lo))
		expected += weight * (float(lo + hi) * 0.5)
		total_w += weight
	if total_w <= 0.001:
		return YOUTH_TALENT_DEFAULT
	return legacy_expected_to_talent(expected / total_w)


static func row_mean_potential(weights: Array) -> float:
	var total := 0.0
	for band in BIRTH_BANDS.size():
		var mean := (float(BIRTH_BANDS[band][0]) + float(BIRTH_BANDS[band][1])) / 2.0
		if ELITE_RATING_WEIGHTS.has(band):
			var conditional: Array = ELITE_RATING_WEIGHTS[band]
			var mass := 0.0
			mean = 0.0
			for i in conditional.size():
				mean += float(conditional[i]) * (float(BIRTH_BANDS[band][0]) + i)
				mass += float(conditional[i])
			mean /= mass
		total += float(weights[band]) / BIRTH_WEIGHT_TOTAL * mean
	return total
