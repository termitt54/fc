const YOUTH_AGES := [15, 16, 17]
const YOUTH_AGE_WEIGHTS := [0.25, 0.45, 0.30]

## Inclusive readiness bands before academy / noise. Keys are age.
const AGE_READINESS := {
	15: [0.40, 0.45],
	16: [0.44, 0.50],
	17: [0.48, 0.55],
}

const ACADEMY_CA_WEIGHT := 0.14
const CA_NOISE := 0.03
